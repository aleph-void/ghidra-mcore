@ifndef MCORE_LE
define endian=big;
@else
define endian=little;
@endif
define alignment=2;

define space ram     type=ram_space      size=4  default;

define space register type=register_space size=4;

define register offset=0x000 size=4 [ 
	r0  r1  r2  r3  r4  r5  r6  r7
	r8  r9  r10 r11 r12 r13 r14 r15
];

define register offset=0x200 size=4 [
	PSR
	VBR
	EPSR
	FPSR
	EPC
	FPC
	SS0
	SS1
	SS2
	SS3
	SS4
	GCR
	GSR
	cr13
	cr14
	cr15
	
	cr16
	cr17
	cr18
	cr19
	cr20
	cr21
	cr22
	cr23
	cr24
	cr25
	cr26
	cr27
	cr28
	cr29
	cr30
	cr31
];

define register offset=0x100 size=1 [ 
	C
];

# program counter (not addressable by instructions)
define register offset=0x300 size=4 [ PC ];

# Include contents of skel.sinc file
@include "mcore.sinc"
