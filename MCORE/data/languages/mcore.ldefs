<?xml version="1.0" encoding="UTF-8"?>

<language_definitions>

   <language processor="MCORE"
            endian="big"
            size="32"
            variant="default"
            version="1.1"
            slafile="mcore.sla"
            processorspec="mcore.pspec"
            id="MCORE:BE:32:default">
    <description>Motorola M-CORE, big-endian</description>
    <compiler name="default" spec="mcore.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="mcore.dwarf"/>
    <external_name tool="gnu" name="mcore"/>
  </language>
   <language processor="MCORE"
            endian="little"
            size="32"
            variant="default"
            version="1.1"
            slafile="mcore_le.sla"
            processorspec="mcore.pspec"
            id="MCORE:LE:32:default">
    <description>Motorola M-CORE, little-endian</description>
    <compiler name="default" spec="mcore_le.cspec" id="default"/>
    <external_name tool="DWARF.register.mapping.file" name="mcore.dwarf"/>
    <external_name tool="gnu" name="mcore"/>
  </language>

</language_definitions>
